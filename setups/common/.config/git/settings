# vim ft=gitconfig
[core]
	excludesfile = ~/.config/git/gitignore_global
	pager = delta
[pager]
	branch = false
[pull]
	rebase = true
[init]
	defaultBranch = main
[rerere]
	enabled = true
[diff]
	algorithm = histogram
[include]
    path = ~/.config/git/themes
[delta]
	features = arctic-fox
[url "git@github.com:"]
	insteadOf = https://github.com/
[user]
	signingkey = ~/.ssh/id_ed25519.pub
[gpg]
	format = ssh
[commit]
	gpgsign = true
